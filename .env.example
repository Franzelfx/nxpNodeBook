# ─────────────────────────────────────────────────────────────────────────────
# nxpNodeBook — copy to .env and adjust.
#
# No API key is needed: every venue stream this node uses is public.
# ─────────────────────────────────────────────────────────────────────────────

NODE_ID=nxp-book

BOOK_DB_DATABASE=book
BOOK_DB_USER=nxp_book
BOOK_DB_PASSWORD=change_me
BOOK_DB_DATA_DIR=/mnt/warehouse/nxp-book/pgdata

# Which books are captured: venue:SYMBOL:label, comma-separated. The label is
# the middle of every derived column name (BOOK.<label>.spread_bps) and must
# never change once data exists under it. Venues: binance_spot,
# binance_futures, deribit.
BOOK_STREAMS=binance_spot:BTCUSDT:btc.spot,binance_futures:BTCUSDT:btc.perp,deribit:BTC-PERPETUAL:btc.dperp

# Full in-memory book written as a replay anchor every N seconds, N levels a side.
BOOK_SNAPSHOT_INTERVAL_SECONDS=300
BOOK_SNAPSHOT_LEVELS=2000

# Raw diff retention in days. 0 keeps everything — see README for measured
# storage rates before changing this either way.
BOOK_EVENTS_RETENTION_DAYS=0

# Depth bands (bp from mid) the depth/imbalance columns are measured over.
BOOK_DEPTH_BANDS_BPS=10,50

BOOK_COLLECTORS_ENABLED=true
BOOK_SCHEDULER_ENABLED=true

# Identify the collector. Keep a contact address in it.
BOOK_USER_AGENT=nxpNodeBook/0.1 (+mailto:fabian@nexpatch.ai) NexPatch AI research data collector

# ─────────────────────────────────────────────────────────────────────────────
# doc/54 E5 — tell the warehouse when rows land (OPTIONAL)
# ─────────────────────────────────────────────────────────────────────────────
# An optimisation only: the warehouse still polls this node on its own
# schedule. Set all THREE or none — with any one missing the node does
# nothing at all, silently, which is the designed behaviour and also why a
# half-configured node looks exactly like an unconfigured one.
#
# Where the warehouse answers. Internal; signed, not open. This node runs in
# Docker Compose, NOT in the cluster, so `nxp-ingest:8010` does not resolve
# from here — use the NodePort: 30081 is prod, 30091 is staging.
# NXP_WAREHOUSE_NOTIFY_URL=http://192.168.2.20:30081/v1/internal/stream/notify
#
# The SAME secret nxp-ingest verifies stream tickets with
# (k8s: secret nxp-stream, key ticket-secret). A different value is a 401 on
# every notify — logged once at warning, then silence.
# NXP_STREAM_TICKET_SECRET=
#
# The warehouse SOURCE id this node feeds — the UUID of the source node on
# the pipeline canvas, not a name. The warehouse resolves it to the sinks it
# has to re-derive; an id it does not know is accepted and does nothing.
# NXP_WAREHOUSE_SOURCE_ID=
